          "raw": "{\r\n    \"context\": {\r\n        \"interopRouteData\": [\r\n            {\r\n                \"denaComponentId\": \"DENA_POSTMAN\",\r\n                \"denaTS\": {{dena_timestamp}}\r\n            }\r\n        ],\r\n        \"messageCorrelationId\": \"{{dena_correlationId}}\",\r\n        \"messageType\": \"ADMIN_SYNC_METADATA\",\r\n        \"flowDirection\": \"REQUEST\",\r\n        \"userAgent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36\",\r\n        \"originPartyId\": \"DENA_POSTMAN\",\r\n        \"destinationPartyId\": \"DENA_INTEROP\"\r\n    },\r\n    \"data\": {\r\n        \"ofType\": \"syncMetaDataFromAdminRequestPayload\",\r\n        \"items\": [\r\n            {\r\n                \"admin\": {\r\n                    \"id\": \"{{adminId}}\"\r\n                },\r\n                \"aboutPerson\": {\r\n                    \"id\": \"{{mock_person_id}}\"\r\n                },\r\n                \"someDataWasUpdatedAt\": \"2026-05-11T09:56:10.2237636Z\",\r\n                \"ofType\": {\r\n                    \"id\": \"{{data_type}}\"\r\n                },\r\n                \"popMessageAfterSync\": {\r\n                    \"how\": \"AT_CLIENT_AFTER_SYNC\",\r\n                    \"messageByLang\": {\r\n                        \"SPANISH\": \"Nuevo expediente de \\\"adminId\\\"\",\r\n                        \"ENGLISH\": \"New procedure from \\\"adminId\\\"\"\r\n                    }\r\n                }\r\n            }\r\n        ]\r\n    }\r\n}",
