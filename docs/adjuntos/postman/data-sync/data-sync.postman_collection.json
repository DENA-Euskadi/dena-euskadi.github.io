  "item": [
    {
      "name": "SEND METADATA Copy",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generar valores reales\r",
              "const timestamp = Date.now();\r",
              "const correlationId = crypto.randomUUID();\r",
              "\r",
              "\r",
              "pm.environment.set(\"dena_timestamp\", timestamp);\r",
              "pm.environment.set(\"dena_correlationId\", correlationId);\r",
              "\r",
              "// Reconstruir body real\r",
              "let body = \"\";\r",
              "\r",
              "if (pm.request.body?.mode === \"raw\") {\r",
              "    body = pm.request.body.raw || \"\";\r",
              "}\r",
              "\r",
              "if (pm.request.body?.mode === \"urlencoded\") {\r",
              "    body = pm.request.body.urlencoded\r",
              "        .filter(p => !p.disabled)\r",
              "        .map(p => `${encodeURIComponent(p.key)}=${encodeURIComponent(p.value)}`)\r",
              "        .join(\"&\");\r",
              "}\r",
              "\r",
              "const originalBody = pm.variables.replaceIn(body);\r",
              "\r",
              "console.log(\"RESQUEST BODY:\", originalBody);\r",
              "\r",
              "// Construir data\r",
              "const dataDena = timestamp + correlationId + originalBody;\r",
              "console.log(\"REQUEST DATA:\", dataDena);\r",
              "\r",
              "// SHA-256 + Base64\r",
              "const denaHash = CryptoJS.SHA256(dataDena);\r",
              "const denaDigestBase64 = CryptoJS.enc.Base64.stringify(denaHash);\r",
              "// Formato tipo Content-Digest\r",
              "const digestHeaderValue = `sha-256=:${denaDigestBase64}:`;\r",
              "\r",
              "\r",
              "// SHA-256 + Base64\r",
              "const hashContentDigest = CryptoJS.SHA256(originalBody);\r",
              "const contentDigestBase64 = CryptoJS.enc.Base64.stringify(hashContentDigest);\r",
              "// Formato tipo Content-Digest\r",
              "const contentDigestHeaderValue = `sha-256=:${contentDigestBase64}:`;\r",
              "\r",
              "\r",
              "// Escribir cabeceras reales\r",
              "pm.request.headers.upsert({\r",
              "    key: \"X-DENA-This-TimeStamp\",\r",
              "    value: timestamp\r",
              "});\r",
              "\r",
              "// Escribir cabeceras reales\r",
              "pm.request.headers.upsert({\r",
              "    key: \"X-DENA-Origin-TimeStamp\",\r",
              "    value: timestamp\r",
              "});\r",
              "\r",
              "\r",
              "pm.request.headers.upsert({\r",
              "    key: \"X-DENA-Message-Correlation-Id\",\r",
              "    value: correlationId\r",
              "});\r",
              "\r",
              "pm.request.headers.upsert({\r",
              "    key: \"X-DENA-Data-Digest\",\r",
              "    value: digestHeaderValue\r",
              "});\r",
              "\r",
              "pm.request.headers.upsert({\r",
              "    key: \"Content-Digest\",\r",
              "    value: contentDigestHeaderValue\r",
              "});\r",
              "\r",
              "\r",
              "\r",
              "// Debug\r",
              "\r",
              "console.log(\"RESQUEST DENA DIGEST:\", digestHeaderValue);\r",
              "console.log(\"RESQUEST CONTENT DIGEST:\", contentDigestHeaderValue);\r",
              "console.log(\"RESQUEST X-DENA-Message-Correlation-Id:\", correlationId);\r",
              "console.log(\"RESQUEST X-DENA-This-TimeStamp:\", timestamp);\r",
              "console.log(\"RESQUEST HEADER_ORIGIN_TIMESTAMP:\", timestamp);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
